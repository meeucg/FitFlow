{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "ApiGateway": "Host=apigateway-postgres;Port=5432;Database=fitflow_gateway;Username=postgres;Password=postgres"
  },
  "InterviewService": {
    "GrpcAddress": "http://interview-grpc-api:8080"
  },
  "FeedCore": {
    "GrpcAddress": "http://feedcore:8080"
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "RecommendationsExchange": "feed-core.recommendations",
    "RecommendationsQueue": "api-gateway.recommendations",
    "RecommendationsRoutingKey": "recommendation.created",
    "DeadLetterExchange": "api-gateway.dead-letter",
    "DeadLetterQueue": "api-gateway.dead-letter",
    "ConsumerCount": 1,
    "PrefetchCount": 10
  },
  "Recommendations": {
    "InitializationPollInterval": "00:00:05",
    "InitializationRetryDelay": "00:00:30",
    "InitializationMaxRetries": 10,
    "SseHeartbeatInterval": "00:00:15",
    "JobPostingCacheTtl": "06:00:00"
  },
  "Authentication": {
    "Authority": "http://localhost:8080/realms/fitflow",
    "MetadataAddress": "http://localhost:8080/realms/fitflow/.well-known/openid-configuration",
    "BackchannelAuthority": "http://keycloak:8080/realms/fitflow",
    "Audience": "fitflow-api",
    "RequireHttpsMetadata": false
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:3002",
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "AllowedHosts": "*"
}
