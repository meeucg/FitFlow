{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=feedcore-postgres;Port=5432;Database=fitflow_feedcore;Username=postgres;Password=postgres"
  },
  "Recommendation": {
    "EmbeddingDimensions": 1536,
    "MatchMaxCosineDistance": 0.35,
    "StarterLookback": "30.00:00:00",
    "StarterRecommendationLimit": 20,
    "MaxUsersPerJob": 1000,
    "PendingEmbeddingBatchSize": 25,
    "PendingEmbeddingPollInterval": "00:00:05"
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "IncomingNormalizedPostingsExchange": "raw-postings-filter.outgoing.mock",
    "IncomingNormalizedPostingsQueue": "feed-core.normalized-postings",
    "IncomingNormalizedPostingsRoutingKey": "job-posting.normalized",
    "OutgoingRecommendationsExchange": "feed-core.recommendations",
    "OutgoingRecommendationsRoutingKey": "recommendation.created",
    "DeadLetterExchange": "feed-core.dead-letter",
    "DeadLetterQueue": "feed-core.dead-letter",
    "ConsumerCount": 2,
    "PrefetchCount": 1
  },
  "EmbeddingAI": {
    "ApiEndpoint": "https://polza.ai/api/v1",
    "ApiKey": "",
    "RetryAfter": "00:03:00",
    "RetryCount": 3
  },
  "EmbeddingAIModels": {
    "DefaultModel": {
      "ModelAlias": "embedding-3-large-1536",
      "ModelName": "openai/text-embedding-3-large",
      "SupportsDimensionControl": true,
      "DimensionCount": 1536
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://+:8080",
        "Protocols": "Http2"
      },
      "Http": {
        "Url": "http://+:8081",
        "Protocols": "Http1"
      }
    }
  }
}
